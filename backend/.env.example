# Copy this file to .env and fill in the values. Never commit .env.

PORT=3001

# Claude API key for the copilot (POST /copiloto). Without it the rest of the API still works.
ANTHROPIC_API_KEY=
# Optional: override the copilot model (default: claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# Database (PostgreSQL). Leave it empty to use a local PGlite database stored in backend/.pglite.
# TigerData: paste the service connection string from the console, using sslmode=verify-full, e.g.
#   postgres://tsdbadmin:<password>@<host>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=verify-full
DATABASE_URL=
# Optional: max Postgres connections per server instance (default 5)
# PG_POOL_MAX=5
