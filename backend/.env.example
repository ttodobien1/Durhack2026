# Copy this file to .env and fill in the values. Never commit .env.

PORT=3001

# Claude API key for the copilot (POST /copiloto). Without it the rest of the API still works.
ANTHROPIC_API_KEY=
# Optional: override the copilot model (default: claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# Database. Local default is a SQLite file inside backend/.
# For Turso (production / Vercel): libsql://<database>-<org>.turso.io plus its auth token.
TURSO_DATABASE_URL=file:lineage.db
TURSO_AUTH_TOKEN=
