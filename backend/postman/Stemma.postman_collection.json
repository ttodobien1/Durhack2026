{
  "info": {
    "name": "Stemma API",
    "description": "Requests for the Stemma backend (DurHack 2026). Set the collection variable `baseUrl` (default http://localhost:3001; use the Vercel URL for production). Run `npm run db:reset` first so the seed data (p-001...p-015, c-001) exists. Suggested flow: Piezas > Fork p-006 (saves forkId) > Edit notes of the fork > Diff fork vs parent > Canciones > Create song > Lineage tree.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "forkId",
      "value": "p-016"
    },
    {
      "key": "cancionId",
      "value": "c-001"
    },
    {
      "key": "notasEditadas",
      "value": "[]"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "usuario",
      "value": "chino"
    },
    {
      "key": "forkCancionId",
      "value": "c-002"
    },
    {
      "key": "trashId",
      "value": ""
    },
    {
      "key": "comentarioId",
      "value": ""
    },
    {
      "key": "inviteToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Cuentas (auth)",
      "description": "Real accounts. Sign up or Log in saves the session token in {{token}}; requests marked \"(token)\" send it as Authorization: Bearer.",
      "item": [
        {
          "name": "Sign up (saves token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('has token', () => pm.expect(pm.response.json().token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/registro",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"{{usuario}}\",\n  \"email\": \"{{usuario}}@example.com\",\n  \"password\": \"secreto1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Log in (saves token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('has token', () => pm.expect(pm.response.json().token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{usuario}}\",\n  \"password\": \"secreto1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "\"usuario\" accepts the username or the email."
          }
        },
        {
          "name": "My account (token)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/auth/yo"
          }
        },
        {
          "name": "Update my profile (token)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/auth/yo",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"perfil\": {\n    \"displayName\": \"Chino\",\n    \"bio\": \"Beatmaker at DurHack\",\n    \"accent\": \"blue\",\n    \"readme\": \"# Hola\",\n    \"pinned\": [],\n    \"avatar\": null\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Public profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/usuarios/{{usuario}}"
          }
        },
        {
          "name": "Fork p-006 as me (token, saves forkId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('forkId', pm.response.json().id);",
                  "pm.test('authored by the account', () => pm.expect(pm.response.json().autor).to.eql(pm.collectionVariables.get('usuario')));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/piezas/p-006/fork",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Edit my fork (token)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/piezas/{{forkId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notas\": [\n    {\n      \"tono\": 57,\n      \"inicio\": 0,\n      \"duracion\": 1,\n      \"velocidad\": 0.8\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Edit my fork without token (401)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/piezas/{{forkId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notas\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Log out (token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/auth/logout"
          }
        },
        {
          "name": "My favorite pieces (token)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/auth/yo/favoritos"
          }
        },
        {
          "name": "Star a piece (token)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/auth/yo/favoritos/p-101"
          }
        },
        {
          "name": "Un-star a piece (token)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/auth/yo/favoritos/p-101"
          }
        }
      ]
    },
    {
      "name": "Piezas",
      "item": [
        {
          "name": "List all pieces",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/piezas"
          }
        },
        {
          "name": "Search (estilo, tipo, tonalidad, q)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/piezas?estilo=salsa&tipo=acordes&tonalidad=Am&q=montuno",
            "description": "All filters are optional. estilo accepts several tags (salsa,romantica). tonalidad accepts Am / A minor / La menor. q is accent- and case-insensitive."
          }
        },
        {
          "name": "Get piece p-005",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/piezas/p-005"
          }
        },
        {
          "name": "Create original piece",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/piezas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Bajo de prueba\",\n  \"tipo\": \"bajo\",\n  \"autor\": \"chino\",\n  \"licencia\": \"CC BY 4.0\",\n  \"fuente\": \"creada en DurHack\",\n  \"tonalidad\": \"Am\",\n  \"tempo\": 96,\n  \"estilo\": [\"salsa\", \"romantica\"],\n  \"compases\": 1,\n  \"notas\": [\n    { \"tono\": 45, \"inicio\": 0.75, \"duracion\": 0.75, \"velocidad\": 0.85 },\n    { \"tono\": 52, \"inicio\": 1.5, \"duracion\": 1.25, \"velocidad\": 0.8 }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Fork p-006 (saves forkId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const fork = pm.response.json();",
                  "pm.test('parent_id points to p-006', () => pm.expect(fork.parent_id).to.eql('p-006'));",
                  "pm.collectionVariables.set('forkId', fork.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/piezas/p-006/fork",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"autor\": \"chino\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Body is optional: { autor, nombre }. Without autor the fork is credited to \"anonymous\"."
          }
        },
        {
          "name": "Edit notes of the fork (moves first note, adds one)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Loads the fork, edits its notes and stores them in {{notasEditadas}} for the body.",
                  "const url = pm.collectionVariables.get('baseUrl') + '/piezas/' + pm.collectionVariables.get('forkId');",
                  "pm.sendRequest(url, (err, res) => {",
                  "  const pieza = res.json();",
                  "  pieza.notas[0].inicio += 0.25;",
                  "  pieza.notas.push({ tono: 88, inicio: 3, duracion: 0.5, velocidad: 0.9 });",
                  "  pm.collectionVariables.set('notasEditadas', JSON.stringify(pieza.notas));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/piezas/{{forkId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Mi montuno\",\n  \"notas\": {{notasEditadas}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "PUT replaces the whole note list. Also accepts nombre, tonalidad, tempo, estilo, compases."
          }
        },
        {
          "name": "Diff fork vs its parent",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/piezas/{{forkId}}/diff"
          }
        },
        {
          "name": "Diff p-006 vs p-005",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/piezas/p-006/diff/p-005",
            "description": ":id is the modified piece, :otra the reference. If one is an ancestor of the other it is always used as the original, whatever the order."
          }
        },
        {
          "name": "Error: unknown tipo (400)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/piezas?tipo=guitarra"
          }
        },
        {
          "name": "Create a private piece (only you see it until it is in a public song)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('private', () => pm.expect(pm.response.json().publica).to.eql(false));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/piezas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"My beat\",\n  \"tipo\": \"ritmo\",\n  \"compases\": 2,\n  \"notas\": [\n    {\n      \"tono\": 36,\n      \"inicio\": 0,\n      \"duracion\": 0.5,\n      \"velocidad\": 0.9\n    },\n    {\n      \"tono\": 38,\n      \"inicio\": 1,\n      \"duracion\": 0.5,\n      \"velocidad\": 0.8\n    }\n  ],\n  \"publica\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Canciones",
      "item": [
        {
          "name": "List songs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/canciones"
          }
        },
        {
          "name": "Get song c-001",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/canciones/c-001"
          }
        },
        {
          "name": "Create song with the fork (saves cancionId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('cancionId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/canciones",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Mi salsa\",\n  \"autor\": \"chino\",\n  \"tempo\": 96,\n  \"pistas\": [\n    { \"instrumento\": \"bateria\", \"bloques\": [{ \"pieza_id\": \"p-001\", \"compas\": 0 }] },\n    { \"instrumento\": \"piano\", \"bloques\": [{ \"pieza_id\": \"{{forkId}}\", \"compas\": 0 }] },\n    { \"instrumento\": \"bajo\", \"bloques\": [{ \"pieza_id\": \"p-007\", \"compas\": 0 }] }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update song (full replace)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/canciones/{{cancionId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Mi salsa (v2)\",\n  \"autor\": \"chino\",\n  \"tempo\": 96,\n  \"pistas\": [\n    { \"instrumento\": \"bateria\", \"bloques\": [{ \"pieza_id\": \"p-001\", \"compas\": 0 }, { \"pieza_id\": \"p-001\", \"compas\": 4 }] },\n    { \"instrumento\": \"bateria\", \"bloques\": [{ \"pieza_id\": \"p-002\", \"compas\": 0 }, { \"pieza_id\": \"p-002\", \"compas\": 4 }] },\n    { \"instrumento\": \"piano\", \"bloques\": [{ \"pieza_id\": \"{{forkId}}\", \"compas\": 0 }, { \"pieza_id\": \"{{forkId}}\", \"compas\": 4 }] },\n    { \"instrumento\": \"bajo\", \"bloques\": [{ \"pieza_id\": \"p-007\", \"compas\": 0 }, { \"pieza_id\": \"p-007\", \"compas\": 4 }] },\n    { \"instrumento\": \"piano\", \"bloques\": [{ \"pieza_id\": \"p-009\", \"compas\": 4 }] }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Lineage tree of the song",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/canciones/{{cancionId}}/arbol"
          }
        },
        {
          "name": "Lineage tree of c-001",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/canciones/c-001/arbol"
          }
        }
      ]
    },
    {
      "name": "Papelera (borrar proyectos)",
      "description": "Deleting a project moves it to the trash (cambios.md §13): its author can restore it for 20 days, then the server deletes it for good. Run Cuentas (auth) > Sign up first so {{token}} is set. Order: create, delete, trash, restore, delete again, delete forever.",
      "item": [
        {
          "name": "Create a project to delete (token, saves trashId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('trashId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/canciones",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Project to delete\",\n  \"tempo\": 90,\n  \"pistas\": [\n    {\n      \"instrumento\": \"piano\",\n      \"bloques\": [\n        {\n          \"pieza_id\": \"p-001\",\n          \"compas\": 0\n        }\n      ]\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete it: moves to the trash (token, 204)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/canciones/{{trashId}}"
          }
        },
        {
          "name": "It is gone from the API (404)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/canciones/{{trashId}}"
          }
        },
        {
          "name": "My trash (token)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/canciones/papelera",
            "description": "Your deleted projects, newest first. Each one carries \"borrada\" (when it was deleted) and \"se_borra\" (when it is deleted for good, 20 days later)."
          }
        },
        {
          "name": "Restore it (token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/canciones/{{trashId}}/restaurar"
          }
        },
        {
          "name": "Delete it again (token, 204)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/canciones/{{trashId}}"
          }
        },
        {
          "name": "Delete it forever (token, 204)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/canciones/papelera/{{trashId}}",
            "description": "Only for projects already in the trash. Cannot be undone: its versions go with it; projects forked from it stay, as originals."
          }
        },
        {
          "name": "Delete without token (401)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/canciones/c-001"
          }
        }
      ]
    },
    {
      "name": "Conexiones (comentarios, colaboradores, propuestas, mensajes)",
      "description": "cambios.md §14. Run Cuentas (auth) > Sign up first so {{token}} is set, then Canciones > Create song with the fork so {{cancionId}} is yours.",
      "item": [
        {
          "name": "Community: popular projects and help requests",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/canciones/comunidad"
          }
        },
        {
          "name": "Ask for ideas on my song (token)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/canciones/{{cancionId}}/ajustes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pide_ayuda\": \"I have the drums but no hook. How would you continue?\",\n  \"permite_fork\": true,\n  \"permite_propuestas\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Comment on my song (token, saves comentarioId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
