            "url": "{{baseUrl}}/canciones",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"My remix of c-001\",\n  \"tempo\": 100,\n  \"parent_id\": \"c-001\",\n  \"parent_version\": 1,\n  \"mensaje\": \"Faster, same pieces\",\n  \"pistas\": [\n    {\n      \"instrumento\": \"bateria\",\n      \"bloques\": [\n        {\n          \"pieza_id\": \"p-001\",\n          \"compas\": 0\n        },\n        {\n          \"pieza_id\": \"p-001\",\n          \"compas\": 4\n        }\n      ]\n    },\n    {\n      \"instrumento\": \"bateria\",\n      \"bloques\": [\n        {\n          \"pieza_id\": \"p-002\",\n          \"compas\": 0\n        },\n        {\n          \"pieza_id\": \"p-002\",\n          \"compas\": 4\n        }\n      ]\n    },\n    {\n      \"instrumento\": \"piano\",\n      \"bloques\": [\n        {\n          \"pieza_id\": \"p-006\",\n          \"compas\": 0\n        },\n        {\n          \"pieza_id\": \"p-006\",\n          \"compas\": 4\n        }\n      ]\n    },\n    {\n      \"instrumento\": \"bajo\",\n      \"bloques\": [\n        {\n          \"pieza_id\": \"p-007\",\n          \"compas\": 0\n        },\n        {\n          \"pieza_id\": \"p-007\",\n          \"compas\": 4\n        }\n      ]\n    },\n    {\n      \"instrumento\": \"piano\",\n      \"bloques\": [\n        {\n          \"pieza_id\": \"p-009\",\n          \"compas\": 4\n        }\n      ]\n    }\n  ]\n}",
